{
  "expo": {
    "name": "PetHuddle",
    "slug": "PetHuddle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pethuddle",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "backgroundImage": "./assets/ic_launcher_background.png",
        "monochromeImage": "./assets/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.PetHuddle.app"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/ic_launcher.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
